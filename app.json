      [
        "react-native-android-widget",
        {
          "fonts": [
            "./node_modules/@expo-google-fonts/caveat/700Bold/Caveat_700Bold.ttf",
            "./node_modules/@expo-google-fonts/caveat/600SemiBold/Caveat_600SemiBold.ttf",
            "./node_modules/@expo-google-fonts/cormorant-garamond/600SemiBold/CormorantGaramond_600SemiBold.ttf",
            "./node_modules/@expo-google-fonts/im-fell-english/400Regular_Italic/IMFellEnglish_400Regular_Italic.ttf"
          ],
          "widgets": [
            {
              "name": "Today",
              "label": "LookBack · today",
              "description": "Today, as it is: a polaroid for a photo, your words on a diary page, your cassette for a recording, a blank tape that cracks when days go unwritten.",
              "minWidth": "250dp",
              "minHeight": "150dp",
              "targetCellWidth": 4,
              "targetCellHeight": 3,
              "previewImage": "./assets/widget-preview.png",
              "updatePeriodMillis": 1800000,
              "resizeMode": "horizontal|vertical"
            },
            {
              "name": "Person",
              "label": "LookBack · from your person",
              "description": "The newest page your person gave you, on blush paper with a wax seal: their photo, their words or their voice.",
              "minWidth": "250dp",
              "minHeight": "150dp",
              "targetCellWidth": 4,
              "targetCellHeight": 3,
              "previewImage": "./assets/widget-person-preview.png",
              "updatePeriodMillis": 1800000,
              "resizeMode": "horizontal|vertical"
            }
          ]
        }
      ],
      "./plugins/withHighRefreshRate",
      "./plugins/withOptionalHardware",
      "./plugins/withReleaseSigning",
      [
        "expo-audio",
        {
          "microphonePermission": "LookBack uses the microphone so you can save a little voice note as today’s moment.",
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": false
        }
      ],
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "LookBack uses the camera to scan the code on a friend's screen when they give you a memory.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      "@config-plugins/react-native-webrtc",
      "./plugins/withWebRtcKeepRules",
      "./plugins/withGradleMemory",
      "expo-sharing"
    ],
