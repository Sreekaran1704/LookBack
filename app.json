{
  "expo": {
    "name": "LookBack",
    "slug": "yearbook",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yearbook.app",
      "infoPlist": {
        "NSCameraUsageDescription": "LookBack uses the camera so you can save a photo as today’s moment.",
        "NSPhotoLibraryUsageDescription": "LookBack lets you pick a photo as today’s moment."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFE9E1",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "allowBackup": false,
      "package": "com.yearbook.app",
      "versionCode": 1
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-font",
      "@react-native-community/datetimepicker",
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "LookBack lets you pick a photo as today’s moment.",
          "cameraPermission": "LookBack uses the camera so you can save a photo as today’s moment."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "largeIcon": "./assets/notification-large.png",
          "color": "#FF6B5E",
          "sounds": [
            "./assets/sounds/chime.wav"
          ]
        }
      ],
      [
        "react-native-nitro-google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.REPLACE_WITH_IOS_CLIENT_ID"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "backgroundColor": "#FBF5E6",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#1B1A18"
          }
        }
      ],
      [
        "expo-alternate-app-icons",
        [
          {
            "name": "Waiting",
            "ios": "./assets/icon-waiting.png",
            "android": {
              "foregroundImage": "./assets/android-icon-waiting-foreground.png",
              "backgroundColor": "#FFE9E1",
              "monochromeImage": "./assets/android-icon-monochrome.png"
            }
          },
          {
            "name": "Missed",
            "ios": "./assets/icon-missed.png",
            "android": {
              "foregroundImage": "./assets/android-icon-missed-foreground.png",
              "backgroundColor": "#FFE9E1",
              "monochromeImage": "./assets/android-icon-monochrome.png"
            }
          },
          {
            "name": "Gone",
            "ios": "./assets/icon-gone.png",
            "android": {
              "foregroundImage": "./assets/android-icon-gone-foreground.png",
              "backgroundColor": "#FFE9E1",
              "monochromeImage": "./assets/android-icon-monochrome.png"
            }
          }
        ]
      ],
      [
        "react-native-android-widget",
        {
          "fonts": [
            "./node_modules/@expo-google-fonts/caveat/700Bold/Caveat_700Bold.ttf",
            "./node_modules/@expo-google-fonts/caveat/600SemiBold/Caveat_600SemiBold.ttf"
          ],
          "widgets": [
            {
              "name": "Today",
              "label": "LookBack · today",
              "description": "Today's page: add a memory in one tap, or see the one you saved.",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "previewImage": "./assets/widget-preview.png",
              "updatePeriodMillis": 1800000,
              "resizeMode": "horizontal|vertical"
            }
          ]
        }
      ],
      "./plugins/withHighRefreshRate",
      "./plugins/withReleaseSigning"
    ],
    "scheme": "yearbook",
    "experiments": {
      "typedRoutes": true
    }
  }
}
