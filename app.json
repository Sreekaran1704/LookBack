{
  "expo": {
    "name": "LookBack",
    "slug": "yearbook",
    "version": "1.3.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yearbook.app",
      "infoPlist": {
        "NSCameraUsageDescription": "LookBack uses the camera so you can save a photo as today’s moment.",
        "NSPhotoLibraryUsageDescription": "LookBack lets you pick a photo as today’s moment."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B0B0C",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "allowBackup": false,
      "package": "com.yearbook.app",
      "versionCode": 4,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-font",
      "@react-native-community/datetimepicker",
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "LookBack lets you pick a photo as today’s moment.",
          "cameraPermission": "LookBack uses the camera so you can save a photo as today’s moment."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "largeIcon": "./assets/notification-large.png",
          "color": "#C9A45C",
          "sounds": [
            "./assets/sounds/chime.wav"
          ]
        }
      ],
      [
        "react-native-nitro-google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.REPLACE_WITH_IOS_CLIENT_ID"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "backgroundColor": "#0B0B0C",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#0B0B0C"
          }
        }
      ],
      [
        "expo-alternate-app-icons",
        [
          {
            "name": "Waiting",
            "ios": "./assets/icon-waiting.png",
            "android": {
              "foregroundImage": "./assets/android-icon-waiting-foreground.png",
              "backgroundColor": "#0B0B0C",
              "monochromeImage": "./assets/android-icon-monochrome.png"
            }
          },
          {
            "name": "Missed",
            "ios": "./assets/icon-missed.png",
            "android": {
              "foregroundImage": "./assets/android-icon-missed-foreground.png",
              "backgroundColor": "#0B0B0C",
              "monochromeImage": "./assets/android-icon-monochrome.png"
            }
          },
          {
            "name": "Gone",
            "ios": "./assets/icon-gone.png",
            "android": {
              "foregroundImage": "./assets/android-icon-gone-foreground.png",
              "backgroundColor": "#0B0B0C",
              "monochromeImage": "./assets/android-icon-monochrome.png"
            }
          }
        ]
      ],
      [
        "react-native-android-widget",
        {
          "fonts": [
            "./node_modules/@expo-google-fonts/caveat/700Bold/Caveat_700Bold.ttf",
            "./node_modules/@expo-google-fonts/caveat/600SemiBold/Caveat_600SemiBold.ttf",
            "./node_modules/@expo-google-fonts/cormorant-garamond/600SemiBold/CormorantGaramond_600SemiBold.ttf",
            "./node_modules/@expo-google-fonts/im-fell-english/400Regular_Italic/IMFellEnglish_400Regular_Italic.ttf"
          ],
          "widgets": [
            {
              "name": "Today",
              "label": "LookBack · today",
              "description": "The diary's cassette: today on its label, cracking when days go unwritten, a postmark when a letter from the past arrives.",
              "minWidth": "250dp",
              "minHeight": "150dp",
              "targetCellWidth": 4,
              "targetCellHeight": 3,
              "previewImage": "./assets/widget-preview.png",
              "updatePeriodMillis": 1800000,
              "resizeMode": "horizontal|vertical"
            }
          ]
        }
      ],
      "./plugins/withHighRefreshRate",
      "./plugins/withReleaseSigning",
      [
        "expo-audio",
        {
          "microphonePermission": "LookBack uses the microphone so you can save a little voice note as today’s moment.",
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": false
        }
      ],
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "LookBack uses the camera to scan the code on a friend's screen when they give you a memory.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      "@config-plugins/react-native-webrtc",
      "./plugins/withWebRtcKeepRules",
      "./plugins/withGradleMemory",
      "expo-sharing"
    ],
    "scheme": "yearbook",
    "experiments": {
      "typedRoutes": true
    }
  }
}
