# Copy to .env and fill in. Never commit .env.
# Google OAuth "Web application" client id (Google Cloud → APIs & Services → Credentials).
# Without it the app builds fine and Settings says Drive backup isn't switched on.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Supabase project URL and public publishable key (never a service-role key).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
